<Window x:Class="Blackjack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Блэкджек — учебный интерфейс" Language="ru-RU"
        Width="920" Height="820" MinWidth="640" MinHeight="600"
        FontFamily="Segoe UI" FontSize="18" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewRoundCommand}" />
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding HitCommand}" />
        <KeyBinding Key="J" Modifiers="Control" Command="{Binding StandCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding SummaryCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False" Padding="24,20">
        <StackPanel>
            <TextBlock Text="Блэкджек" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Учебный пример: карты заранее заданы, правила игры ещё не подключены."
                       TextWrapping="Wrap" Margin="0,6,0,16" />

            <WrapPanel>
                <Button x:Name="NewRoundButton" Content="Новая раздача (Ctrl+N)"
                        Command="{Binding NewRoundCommand}" TabIndex="0"
                        AutomationProperties.Name="Новая раздача"
                        AutomationProperties.AcceleratorKey="Ctrl+N"
                        AutomationProperties.HelpText="Начать демонстрационный раунд с заранее заданными картами." />
                <Button x:Name="HitButton" Content="Взять карту (Ctrl+H)"
                        Command="{Binding HitCommand}" TabIndex="1"
                        AutomationProperties.Name="Взять карту"
                        AutomationProperties.AcceleratorKey="Ctrl+H"
                        AutomationProperties.HelpText="В этом примере можно взять одну дополнительную карту." />
                <Button x:Name="StandButton" Content="Остановиться (Ctrl+J)"
                        Command="{Binding StandCommand}" TabIndex="2"
                        AutomationProperties.Name="Остановиться"
                        AutomationProperties.AcceleratorKey="Ctrl+J" />
                <Button Content="Сводка (Ctrl+I)" Command="{Binding SummaryCommand}" TabIndex="3"
                        AutomationProperties.Name="Сводка" AutomationProperties.AcceleratorKey="Ctrl+I"
                        AutomationProperties.HelpText="Показать сводку и передать сообщение скринридеру без переноса фокуса." />
            </WrapPanel>

            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,4,0,16" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <GroupBox Header="Ваши карты" Grid.Column="0">
                    <TextBox Text="{Binding PlayerText, Mode=OneWay}" MinHeight="112" TabIndex="4"
                             AutomationProperties.Name="Ваши карты и очки" />
                </GroupBox>
                <GroupBox Header="Дилер" Grid.Column="2">
                    <TextBox Text="{Binding DealerText, Mode=OneWay}" MinHeight="112" TabIndex="5"
                             AutomationProperties.Name="Доступная информация о дилере" />
                </GroupBox>
            </Grid>

            <GroupBox Header="Результат">
                <TextBox Text="{Binding ResultText, Mode=OneWay}" TabIndex="6"
                         AutomationProperties.Name="Результат раунда" />
            </GroupBox>

            <GroupBox Header="Последнее сообщение и сводка">
                <TextBox x:Name="SummaryBox" Text="{Binding SummaryText, Mode=OneWay}" TabIndex="7"
                         AutomationProperties.Name="Последнее сообщение и сводка" />
            </GroupBox>

            <DockPanel Margin="0,0,0,6">
                <Button Content="Перейти в историю (Ctrl+L)" Click="FocusHistory_Click" TabIndex="8"
                        AutomationProperties.Name="Перейти в историю" AutomationProperties.AcceleratorKey="Ctrl+L" />
            </DockPanel>
            <GroupBox Header="История ходов">
                <ListBox x:Name="HistoryList" ItemsSource="{Binding History}" Height="190" TabIndex="9"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                         Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                         AutomationProperties.Name="История ходов"
                         AutomationProperties.HelpText="Стрелки вверх и вниз — сообщения. Home и End — начало и конец. Ctrl+C — копировать выбранное сообщение."
                         PreviewKeyDown="HistoryList_PreviewKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="6,4" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <WrapPanel>
                <Button Content="Справка (F1)" Click="Help_Click" TabIndex="10"
                        AutomationProperties.Name="Справка по управлению" AutomationProperties.AcceleratorKey="F1" />
                <TextBlock Text="Tab — переход по элементам. Alt+F4 — выход."
                           TextWrapping="Wrap" Margin="4,10,0,0" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>

